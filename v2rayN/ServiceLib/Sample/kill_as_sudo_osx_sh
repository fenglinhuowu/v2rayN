#!/bin/bash
#
# Process Terminator Script for macOS
# This script forcibly terminates a process and all its descendant processes

# Check if PID argument is provided
if [ $# -ne 1 ]; then
    echo "Usage: $0 <PID>"
    exit 1
fi

PID=$1

# Validate that input is a valid PID (numeric)
if ! [[ "$PID" =~ ^[0-9]+$ ]]; then
    echo "Error: The PID must be a numeric value"
    exit 1
fi

# Check if the process exists - using kill -0 which is more reliable on macOS
if ! kill -0 $PID 2>/dev/null; then
    echo "Warning: No process found with PID $PID"
    exit 0
fi

# Recursive function to find all descendant processes
collect_descendants() {
    local parent=$1
    local children=$(ps -axo pid=,ppid= | awk -v ppid=$parent '$2==ppid {print $1}')
    for child in $children; do
        echo "$child"
        collect_descendants "$child"
    done
}

echo "============================================"
echo "Starting termination of process $PID and all its descendants"
echo "============================================"

# Collect ALL descendant PIDs BEFORE killing anything.
# This prevents orphaned child processes when the parent exits
# early (e.g. sudo forwards SIGTERM and exits, leaving xray orphaned).
ALL_PIDS="$PID"
for desc in $(collect_descendants "$PID"); do
    ALL_PIDS="$ALL_PIDS $desc"
done

echo "All PIDs to terminate: $ALL_PIDS"

# Try graceful termination first (SIGTERM to all)
echo "Attempting graceful termination (SIGTERM)..."
for pid in $ALL_PIDS; do
    echo "  SIGTERM -> PID: $pid"
    kill -15 "$pid" 2>/dev/null || true
done
sleep 1

# Force kill any still alive processes (SIGKILL)
for pid in $ALL_PIDS; do
    if kill -0 $pid 2>/dev/null; then
        echo "  Process $pid did not exit after SIGTERM; sending SIGKILL"
        kill -9 "$pid" 2>/dev/null || true
    else
        echo "  Process $pid exited cleanly after SIGTERM"
    fi
done

# Wait a little for process/port resources to be fully released
FINAL_WAIT_SECONDS=1
echo "Waiting ${FINAL_WAIT_SECONDS}s for resources to settle..."
sleep "$FINAL_WAIT_SECONDS"

echo "============================================"
echo "Process $PID and all its descendants have been terminated"
echo "============================================"

exit 0
